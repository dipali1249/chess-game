# Learners Chess — high-score backend configuration.
# Copy this to .env (never commit it) and fill it in, or export these in your shell.

# Port the server listens on
PORT=8080

# A GitHub token with "Contents: read and write" on this repository. This is what
# lets the server commit data/highscore.json back to the repo. WITHOUT a token the
# server runs in local mode and reads/writes the file on disk only.
GITHUB_TOKEN=

# Repository the record is committed to
GITHUB_OWNER=dipali1249
GITHUB_REPO=chess-game
GITHUB_BRANCH=main

# Path of the record file inside the repository
HIGHSCORE_PATH=data/highscore.json

# Origin allowed to call the API — set this to your site's origin in production
CORS_ORIGIN=*
